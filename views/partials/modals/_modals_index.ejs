<div id="ticket-modal" class="modal">
    <div class="modal-content">
        <span class="close-button">&times;</span>
        <h2 id="ticket-modal-title"></h2>
        <form id="ticket-form">
            <input type="hidden" id="ticket-type" name="ticket_type">
            <div class="form-row">
                <div class="form-group"><label for="ticket-apellido">Apellido*</label><input type="text" id="ticket-apellido" name="apellido" required></div>
                <div class="form-group"><label for="ticket-nombre">Nombre*</label><input type="text" id="ticket-nombre" name="nombre" required></div>
            </div>
            <div class="form-group"><label for="ticket-dependencia">Dependencia</label><select id="ticket-dependencia" name="dependencia_id"></select></div>
            <div class="form-group"><label for="ticket-problema">Problema</label><select id="ticket-problema" name="problema"></select></div>
            <div class="form-group"><label for="ticket-description">Descripción Detallada*</label><textarea id="ticket-description" name="description" rows="4" required></textarea></div>
            <button type="submit">Enviar Pedido</button>
        </form>
    </div>
</div>

